LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=20
MAX_UPLOAD_SIZE_MB=5
PREVIEW_ROW_LIMIT=50
DATABASE_URL=postgresql://user:password@host:port/dbname
